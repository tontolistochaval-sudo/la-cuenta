# Copia este archivo a .env.local y rellénalo (.env.local no se sube a GitHub).

# Clave gratuita de CARTO Basemaps (https://carto.com/basemaps/apikey). Sin ella el mapa sale con marca de agua.
VITE_CARTO_KEY=

# Supabase (Project Settings → API): para sincronizar los dos móviles.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
